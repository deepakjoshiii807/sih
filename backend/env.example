# Django backend environment — export these (or place as .env next to
# docker-compose.yml — Compose auto-loads .env). The app runs with no env at
# all for local SQLite demo; only SECRET_KEY is mandatory once DEBUG=False.

# Django
SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Database — leave empty for SQLite, or a Postgres URL:
#   postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# CORS
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo seed
SEED_DEMO=1
DEMO_PASSWORD=DemoPass@123

# gunicorn (used by the container)
WEB_CONCURRENCY=2
WEB_THREADS=2
